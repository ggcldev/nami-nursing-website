---
// Phones only: call bar fixed to the bottom of the screen (under review: call-button redundancy).
import LineIcon from './LineIcon.astro';
import { site } from '../data/site';
---

<a href={site.phone.href} class="m-call num" data-track-location="mobile_bar">
  <LineIcon name="phone" size={22} />Call {site.phone.display}
</a>

<style>
  .m-call { display: none; }
  @media (max-width: 760px) {
    .m-call {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 20;
      min-height: 58px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: var(--navy);
      color: #fff;
      border: 2px solid #fff;
      border-radius: 12px;
      font-weight: 700;
      font-size: 18px;
      text-decoration: none;
    }
    .m-call:focus-visible {
      outline: 3px solid var(--teal);
      outline-offset: 3px;
    }
  }
</style>
