---
import LineIcon from './LineIcon.astro';
import HeroMotion from './HeroMotion.astro';
import { site } from '../data/site';

const ticks = ['Seven days a week', 'Nursing support 24/7', 'Self-managed and plan-managed welcome'];
---

<section id="contact" class="cta pad on-dark" aria-labelledby="cta-title" data-track-location="cta">
  <!-- Same floating shapes as the hero, recoloured for teal; the hero's pause button stops both. -->
  <HeroMotion tone="teal" controls={false} />
  <div class="container cta-inner reveal">
    <div class="cta-copy">
      <h2 id="cta-title" class="cta-h">Let's start a conversation</h2>
      <p class="cta-text">Have a question or ready to get started? Call us, or send a message and we will call you back.</p>
      <ul class="ticks cta-ticks" aria-label="What you can count on">
        {ticks.map((t) => <li><LineIcon name="check" />{t}</li>)}
      </ul>
    </div>
    <div class="cta-actions">
      <div class="cta-buttons">
        <a href={site.phone.href} class="btn btn--white cta-btn cta-call num">
          <LineIcon name="phone" size={22} />Call {site.phone.display}
        </a>
        <a href="#start" class="btn btn--ghost cta-btn cta-msg">
          Send a message <LineIcon name="arrow" class="nudge" />
        </a>
      </div>
      <p class="cta-email">Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--teal-dark);
    color: #fff;
    padding-top: 128px;
    padding-bottom: 136px;
  }
  .cta-inner {
    position: relative;
    z-index: 1; /* above the floating shapes */
    display: flex;
    flex-direction: column;
    gap: 36px;
    align-items: center;
    text-align: center;
  }
  .cta-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
  }
  .cta-h {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 46px;
    line-height: 1.12;
    text-wrap: balance;
  }
  .cta-text {
    margin: 0;
    max-width: 30em;
    font-size: 19px;
    line-height: 1.6;
  }
  .cta-ticks {
    margin-top: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--teal);
    justify-content: center;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
    align-items: center;
    justify-content: center;
  }
  .cta-btn {
    min-height: 64px;
    padding: 16px 28px;
  }
  /* Call: white at rest (strongest contrast on teal, the page's main action); brand purple on
     hover/focus with a white edge so the button outline stays clear against the teal. */
  .cta-call:hover,
  .cta-call:focus-visible {
    background: var(--navy);
    color: #fff;
    box-shadow: 0 0 0 2px #fff;
  }
  /* Send a message: outline at rest, the same brand purple on hover/focus (its white border
     stays, so the edge is clear). */
  .cta-msg:hover,
  .cta-msg:focus-visible {
    background: var(--navy);
    color: #fff;
    border-color: #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-call,
    .cta-msg {
      transition: background-color 0.18s ease-out, color 0.18s ease-out, box-shadow 0.18s ease-out, border-color 0.18s ease-out;
    }
  }
  .cta-email {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }
  .cta-email a {
    font-weight: 700;
    color: #fff;
  }
  @media (max-width: 1279px) {
    .cta-h { font-size: clamp(34px, 4vw, 44px); }
  }
  @media (max-width: 760px) {
    .cta {
      padding-top: 88px;
      padding-bottom: 96px;
    }
    .cta-h { font-size: 32px; }
    .cta-ticks {
      flex-direction: column;
      align-items: flex-start;
      align-self: center;
      text-align: left;
    }
    .cta-actions,
    .cta-buttons {
      align-self: stretch;
      width: 100%;
    }
    .cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
