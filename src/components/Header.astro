---
import Logo from './Logo.astro';
import LineIcon from './LineIcon.astro';
import { site } from '../data/site';

const links = [
  { label: 'Services', href: '#services' },
  { label: 'Contact', href: '#location' },
  { label: 'FAQs', href: '#faq' },
];
---

<header class="site-header pad" data-track-location="header">
  <div class="head-row container">
    <Logo class="head-logo" />

    <button type="button" class="burger" aria-expanded="false" aria-controls="main-nav">
      <LineIcon name="menu" size={24} class="i-open" />
      <LineIcon name="close" size={24} class="i-close" />
      <span class="burger-label">Menu</span>
    </button>

    <nav id="main-nav" class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={site.phone.href} class="nav-call num">
        <LineIcon name="phone" size={22} />Call {site.phone.display}
      </a>
    </nav>

    <a href={site.phone.href} class="btn btn--navy head-phone num" aria-label={`Call ${site.phone.display}`}>
      <LineIcon name="phone" size={22} />
      <span class="head-num">{site.phone.display}</span>
    </a>
  </div>
</header>

<style>
  /* Sticky: always one tap from the phone number. At the top it is a full-width white bar; once
     the page scrolls it becomes a floating frosted-glass pill (Apple/macOS style) and the page
     shows, blurred, through it. Total height never changes (header padding shrinks by exactly
     what the pill adds), so nothing below jumps. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #fff;
    border-bottom: 1px solid var(--line-soft);
    padding-top: 18px;
    padding-bottom: 18px;
    /* Take up no space: the hero starts at the very top and runs underneath, so the glass pill
       always floats over the navy hero, never over an empty white strip. The hero adds the
       header height to its own top padding (Hero.astro). */
    margin-bottom: calc(-1 * var(--header-h));
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    align-items: center;
    justify-content: space-between;
    border-radius: 0;
  }

  .site-header.is-scrolled {
    background: transparent;
    border-bottom-color: transparent;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .site-header.is-scrolled .head-row {
    max-width: 1280px;
    padding: 6px 6px 6px 32px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow:
      0 12px 32px rgb(23 22 42 / 0.18),
      0 2px 6px rgb(23 22 42 / 0.08),
      inset 0 0 0 1px rgb(51 42 111 / 0.08);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header.is-scrolled .head-row {
      background: rgb(255 255 255 / 0.8);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
    }
    /* Open menu: near-solid so page text never shows through the links. */
    .site-header.is-scrolled:has(.burger[aria-expanded='true']) .head-row {
      background: rgb(255 255 255 / 0.97);
    }
  }
  .site-header.is-scrolled .head-phone,
  .site-header.is-scrolled .burger {
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: background-color 0.3s ease, border-color 0.3s ease, padding 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .head-row {
      transition:
        max-width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
        padding 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
        border-radius 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
        background-color 0.3s ease,
        box-shadow 0.4s ease;
    }
    .head-phone,
    .burger { transition: background-color 0.18s ease-out, border-radius 0.4s ease; }
  }

  @media (max-width: 959px) {
    .site-header.is-scrolled .head-row { padding: 6px 6px 6px 20px; }
    /* Open menu: the pill becomes a rounded card so the links fit; a menu taller than the
       screen scrolls inside the header. */
    .site-header:has(.burger[aria-expanded='true']) {
      max-height: 100dvh;
      overflow-y: auto;
    }
    .site-header.is-scrolled:has(.burger[aria-expanded='true']) .head-row {
      border-radius: 28px;
      padding-right: 20px;
    }
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 36px;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
  }
  .nav a {
    text-decoration: none;
    padding: 12px 0;
  }
  .nav a:hover { text-decoration: underline; }
  .nav-call {
    display: none;
    align-items: center;
    gap: 12px;
    font-weight: 700;
  }
  .head-phone { gap: 12px; padding: 14px 24px; }

  .burger {
    display: none;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: var(--navy);
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    padding: 0 18px;
    min-height: 60px;
    font-weight: 700;
    font-size: 16px;
  }
  .burger:hover { background: var(--lav-150); }
  .burger :global(.i-close) { display: none; }
  .burger[aria-expanded='true'] :global(.i-open) { display: none; }
  .burger[aria-expanded='true'] :global(.i-close) { display: block; }

  @media (max-width: 959px) {
    .head-row {
      gap: 10px 12px;
      justify-content: flex-start;
    }
    .head-row :global(.head-logo) { margin-right: auto; }
    .head-phone { order: 1; }
    .burger { order: 2; }
    .nav {
      order: 3;
      width: 100%;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      font-size: 18px;
      border-top: 1px solid var(--line-soft);
      margin-top: 6px;
    }
    .nav a {
      padding: 16px 4px;
      border-bottom: 1px solid var(--line-soft);
    }
    .nav a:last-child { border-bottom: 0; }
    .nav .nav-call { display: flex; }

    /* With JS the nav collapses behind the burger; without JS it stays open. */
    :global(.js) .burger { display: inline-flex; }
    :global(.js) .nav { display: none; }
    :global(.js) .burger[aria-expanded='true'] ~ .nav { display: flex; }
  }

  @media (max-width: 760px) {
    .head-phone {
      padding: 10px 14px;
      min-height: 48px;
      font-size: 16px;
    }
    .burger {
      padding: 0 14px;
      min-height: 48px;
    }
  }

  @media (max-width: 479px) {
    .head-num,
    .burger-label {
      display: none;
    }
    .head-phone,
    .burger {
      padding: 0;
      width: 48px;
      justify-content: center;
    }
    .head-row { gap: 10px; }
    .head-row :global(.head-logo) { gap: 10px; }
    .head-row :global(.head-logo svg) {
      width: 36px;
      height: 25px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    // Expose the header height so in-page links land below it (scroll-padding-top in global.css).
    const setHeight = () =>
      document.documentElement.style.setProperty('--header-h', `${header.getBoundingClientRect().height}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(header);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        header.classList.toggle('is-scrolled', window.scrollY > 24);
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('main-nav');

  if (burger && nav) {
    const label = burger.querySelector('.burger-label');
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };

    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
    // Reset if the window grows past the mobile breakpoint.
    matchMedia('(min-width: 960px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
