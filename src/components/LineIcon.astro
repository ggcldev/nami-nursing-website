---
// Small stroke icons used inside buttons and lists (from the approved design).
interface Props {
  name: 'phone' | 'check' | 'arrow' | 'plus' | 'menu' | 'close' | 'photo' | 'check-circle';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const icons: Record<Props['name'], { d: string[]; sw: number; circle?: boolean }> = {
  phone: {
    sw: 2.2,
    d: [
      'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z',
    ],
  },
  check: { sw: 3, d: ['M5 12l5 5L20 7'] },
  arrow: { sw: 2.4, d: ['M5 12h14M13 6l6 6-6 6'] },
  plus: { sw: 2.4, d: ['M12 5v14M5 12h14'] },
  menu: { sw: 2.4, d: ['M4 7h16M4 12h16M4 17h16'] },
  close: { sw: 2.4, d: ['M6 6l12 12M18 6L6 18'] },
  photo: { sw: 1.8, d: ['M3 6h18v13H3zM3 16l5-5 4 4 3-3 6 6', 'M16.5 9.5a1 1 0 1 0 0-.01'] },
  'check-circle': { sw: 2.4, circle: true, d: ['M7 12l3 3 7-7'] },
};

const icon = icons[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={icon.sw}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {icon.circle && <circle cx="12" cy="12" r="10" />}
  {icon.d.map((d) => <path d={d} />)}
</svg>
